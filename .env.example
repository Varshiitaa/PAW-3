# StreetPaw.AI System Configuration Environment Variables

# Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./streetpaw.db
# DATABASE_URL=postgresql://streetpaw_user:secure_password@localhost:5432/streetpaw_db

# Security & Authentication
JWT_SECRET=super_secret_streetpaw_jwt_signing_key_2026_dsu
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# AI Advisory Engine (Anthropic Claude API Key & Configurable Model)
# Set your Anthropic API key here to enable live streaming AI responses from Pawly
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CHAT_MODEL=claude-3-5-sonnet-20241022

# Frontend Client API Endpoint Configuration
VITE_API_BASE_URL=http://localhost:8000

# Map Engine Settings (Mapbox / OpenStreetMap tile token)
MAPBOX_TOKEN=your_mapbox_public_token_here
DEFAULT_LATITUDE=12.9716
DEFAULT_LONGITUDE=77.5946

